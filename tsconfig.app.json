{
  "include": ["env.d.ts", "src/**/*"],
  "exclude": ["src/**/*.{test,spec}.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,

    "noUncheckedIndexedAccess": true,
    "noEmit": true,

    "paths": { "@/*": ["./src/*"] },

    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  }
}
