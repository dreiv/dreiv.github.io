{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": {
      "cache": true
    },
    "type-check": {
      "cache": true
    },
    "format:check": {
      "cache": true
    },
    "build:vite": {
      "outputs": ["dist/**"],
      "cache": true
    },
    "turbo:build": {
      "dependsOn": ["lint", "type-check", "format:check", "build:vite"]
    }
  }
}
