{
  "name": "dreiv.github.io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "prepare": "husky",
    "check": "turbo run lint type-check format:check",
    "check:deps": "knip",
    "fix": "oxlint . --fix -D correctness --ignore-path .oxlintignore && eslint . --fix --cache && oxfmt . --ignore-path .oxfmtignore",
    "fix:lint": "oxlint . --fix -D correctness --ignore-path .oxlintignore && eslint . --fix --cache",
    "fix:format": "oxfmt . --ignore-path .oxfmtignore",
    "lint": "oxlint . --fix -D correctness --ignore-path .oxlintignore && eslint . --fix --cache",
    "type-check": "tsc --noEmit",
    "format:check": "oxfmt --check . --ignore-path .oxfmtignore",
    "test": "vitest",
    "test:unit": "vitest --project=unit",
    "test:browser": "vitest --project=browser",
    "test:e2e": "playwright test",
    "build": "turbo run lint type-check format:check && vite build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.12.2",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-playwright": "^2.10.1",
    "husky": "^9.1.7",
    "knip": "^5.43.0",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.45.0",
    "oxlint": "~1.60.0",
    "turbo": "^2.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix -D correctness",
      "eslint --fix --cache",
      "vitest related --run",
      "oxfmt"
    ],
    "*.{css,json,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "npm@11.12.1"
}
