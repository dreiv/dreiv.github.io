{
  "name": "dreiv.github.io",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "prepare": "husky",
    "check": "turbo run lint type-check format:check",
    "fix": "oxlint . --fix -D correctness --ignore-path .oxlintignore && eslint . --fix --cache && oxfmt . --ignore-path .oxfmtignore",
    "fix:lint": "oxlint . --fix -D correctness --ignore-path .oxlintignore && eslint . --fix --cache",
    "fix:format": "oxfmt . --ignore-path .oxfmtignore",
    "lint": "oxlint . --fix -D correctness --ignore-path .oxlintignore && eslint . --fix --cache",
    "type-check": "tsc --noEmit",
    "format:check": "oxfmt --check . --ignore-path .oxfmtignore",
    "test": "vitest",
    "test:unit": "vitest --project=unit",
    "test:browser": "vitest --project=browser",
    "test:e2e": "playwright test",
    "build": "turbo run lint type-check format:check && vite build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.1.0",
    "@vitest/browser-playwright": "^4.1.9",
    "@vitest/eslint-plugin": "^1.6.21",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.72.0",
    "eslint-plugin-playwright": "^2.10.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.57.0",
    "oxlint": "~1.72.0",
    "turbo": "^2.10.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix -D correctness",
      "eslint --fix --cache",
      "vitest related --run",
      "oxfmt"
    ],
    "*.{css,json,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "npm@11.12.1"
}
